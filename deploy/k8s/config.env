# Non-secret control plane settings (ConfigMap "controlplane-config").
CP_ENVIRONMENT=production
CP_PUBLIC_BASE_URL=https://app.example.com
CP_IDE_BASE_URL=https://ide.example-ide.com
CP_INTERNAL_BASE_URL=http://controlplane.agentsociety.svc.cluster.local:8000
CP_FORWARDED_ALLOW_IPS=*
CP_BRAND_NAME=Societas
CP_SANDBOX_DRIVER=kubernetes
CP_K8S_NAMESPACE=agentsociety-sandboxes
CP_SANDBOX_IMAGE=agentsociety-saas/sandbox:latest
CP_K8S_STORAGE_CLASS=
CP_K8S_VOLUME_SIZE=10Gi
# "gvisor" after applying optional/runtimeclass-gvisor.yaml on gVisor-enabled nodes.
CP_K8S_RUNTIME_CLASS=
CP_MODEL_CATALOG_FILE=
CP_DEFAULT_SIM_MODEL=gpt-5.5
CP_DEFAULT_EMBEDDING_MODEL=text-embedding-3-large
CP_DEFAULT_CHAT_MODEL=claude-opus-5-5
CP_DEFAULT_CHAT_SMALL_MODEL=claude-haiku-5-5
CP_PRICE_MULTIPLIER=1.0
CP_SIGNUP_CREDIT_USD=5
CP_ALLOW_SIGNUP=true
CP_BLOB_BACKEND=s3
CP_S3_BUCKET=
CP_S3_ENDPOINT_URL=
CP_S3_REGION=
CP_MAPBOX_TOKEN=
CP_OPENALEX_MAILTO=
