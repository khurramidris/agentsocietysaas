# Copy to .env next to compose.yaml and fill in. Never commit the copy.

# ---- hosts -------------------------------------------------------------------
# The web app + API, and a separate origin for the browser IDE (a different
# registrable domain is best, so workspace code never runs on the app origin).
DOMAIN=app.example.com
IDE_DOMAIN=ide.example-ide.com
ACME_EMAIL=ops@example.com
CP_PUBLIC_BASE_URL=https://app.example.com
CP_IDE_BASE_URL=https://ide.example-ide.com
CP_BRAND_NAME=Societas

# ---- secrets -----------------------------------------------------------------
POSTGRES_PASSWORD=
# openssl rand -hex 32
CP_SECRET_KEY=
# python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CP_ENCRYPTION_KEY=
# First platform admin, created on first start.
CP_BOOTSTRAP_ADMIN_EMAIL=
CP_BOOTSTRAP_ADMIN_PASSWORD=

# ---- docker ------------------------------------------------------------------
# getent group docker | cut -d: -f3
DOCKER_GID=
# gVisor gives sandboxes a separate kernel; install runsc first (README.md).
CP_DOCKER_RUNTIME=
CONTROLPLANE_IMAGE=agentsociety-saas/controlplane:latest
SANDBOX_IMAGE=agentsociety-saas/sandbox:latest
SANDBOX_WITH_LATEX=true
SANDBOX_WITH_IDE=true
SANDBOX_WITH_TORCH=false

# ---- models ------------------------------------------------------------------
# Claude models (AI scientist) are seeded when this is set.
CP_ANTHROPIC_API_KEY=
CP_OPENAI_API_KEY=
# Other providers and prices: copy ../model_catalog.example.json to ./config/model_catalog.json.
CP_MODEL_CATALOG_FILE=/config/model_catalog.json
CP_DEFAULT_SIM_MODEL=gpt-5.5
CP_DEFAULT_EMBEDDING_MODEL=text-embedding-3-large
CP_DEFAULT_CHAT_MODEL=claude-opus-5-5
CP_DEFAULT_CHAT_SMALL_MODEL=claude-haiku-5-5
# Customer price = provider list price x this.
CP_PRICE_MULTIPLIER=1.0

# ---- billing -----------------------------------------------------------------
CP_SIGNUP_CREDIT_USD=5
CP_STRIPE_SECRET_KEY=
# Webhook endpoint: https://<DOMAIN>/api/v1/billing/stripe/webhook
CP_STRIPE_WEBHOOK_SECRET=
CP_STRIPE_PRICE_PRO=
CP_STRIPE_PRICE_TEAM=

# ---- storage -----------------------------------------------------------------
# Dataset packages live in the control plane volume unless you use S3/R2/MinIO
# (the bucket needs CORS for PUT from DOMAIN: browsers upload parts directly).
CP_BLOB_BACKEND=local
CP_S3_BUCKET=
CP_S3_ENDPOINT_URL=
CP_S3_REGION=

# ---- optional ----------------------------------------------------------------
CP_ALLOW_SIGNUP=true
# Public (pk.*) token for the replay map.
CP_MAPBOX_TOKEN=
# Polite-pool contact for OpenAlex.
CP_OPENALEX_MAILTO=
